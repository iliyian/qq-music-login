QQ_UIN=你的QQ号
QQ_PASSWORD=你的QQ密码
VERCEL_TOKEN=你的Vercel API Token
VERCEL_PROJECT_ID=你的Vercel项目ID

# 可选：初始 cookie（配置后优先使用 cookie 登录，跳过账号密码和安全验证）
# 从浏览器开发者工具中复制 y.qq.com 的 cookie 字符串
# 格式: key1=val1; key2=val2; ...
# v2.0 起首次浏览器登录成功后会把 storage_state 存到 state/session.json，
# 之后自动优先走静默续期，INIT_COOKIE 仅作为冷启动兜底。
INIT_COOKIE=

# 可选：Telegram 通知（不配置则跳过通知）
TELEGRAM_BOT_TOKEN=你的Telegram Bot Token
TELEGRAM_CHAT_ID=你的Telegram Chat ID

# 可选：短信验证码数据源（不配置则跳过短信分支）
# 方式1: Telegram Bot 轮询（默认复用 TELEGRAM_BOT_TOKEN/CHAT_ID，也可单独指定）
SMS_TELEGRAM_BOT_TOKEN=
SMS_TELEGRAM_CHAT_ID=
# 方式2: 本地 webhook drop 文件（SMS Forwarder 等落盘），每行 JSON {"text":"...","ts":unix秒} 或纯文本
SMS_DROP_FILE=state/sms.txt
# 时间窗口：忽略多少秒之前的旧短信消息，防止把历史短信当本次验证码
SMS_WINDOW_S=600

# 可选：AI 登录循环硬限制
LOOP_MAX_STEPS=25
LOOP_STEP_TIMEOUT_S=30
LOOP_TOTAL_TIMEOUT_S=900
# 滑块验证码自动尝试次数
SLIDER_MAX_ATTEMPTS=3

# 可选：代理（不配置则直连）
# QQ_MUSIC_PROXY: 浏览器访问QQ音乐使用的代理
# TELEGRAM_PROXY: 发送Telegram通知使用的代理
# VERCEL_PROXY: 访问Vercel API使用的代理
QQ_MUSIC_PROXY=http://127.0.0.1:7890
TELEGRAM_PROXY=http://127.0.0.1:7890
VERCEL_PROXY=http://127.0.0.1:7890